# 복사해서 .env 로 만들고 값을 채우세요:  copy .env.example .env

# OpenAI (기사 3줄 요약 · "왜 중요한가" 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 네이버 검색 API (뉴스 수집) — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 수집 설정
NEWS_KEYWORDS=부동산,아파트 매매,전세,청약,주택담보대출,분양,재건축
NEWS_MAX_PER_KEYWORD=30
PUBLISH_HOUR_KST=6

# 공개 사이트 (인스타가 카드 이미지를 여기서 가져감)
SITE_URL=https://hyungmo1234.github.io/daily-house

# Instagram Graph API — 비즈니스/크리에이터 계정 + Meta 앱 필요
# 비워 두면 카드만 만들고 게시는 건너뜀
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
